# ============================================================
# Threads Scraper Bot - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/threads.db

# --- Threads Account (for search functionality) ---
THREADS_USERNAME=
THREADS_PASSWORD=

# --- Proxy Configuration ---
# Comma-separated list of proxies (protocol://user:pass@host:port)
# Supports: http, https, socks5
# Example: http://user:pass@proxy1.com:8080,socks5://proxy2.com:1080
PROXY_LIST=
# Or load from a URL that returns a list of proxies
PROXY_LIST_URL=
# Enable/disable proxy rotation
PROXY_ENABLED=false

# --- CAPTCHA Solver ---
# Service: 2captcha, anticaptcha, or empty to disable
CAPTCHA_SERVICE=
CAPTCHA_API_KEY=

# --- Scraper Settings ---
# Polling interval in seconds (30-600, default: 120)
POLLING_INTERVAL=120
# Max concurrent scraping sessions (1-5, default: 2)
MAX_CONCURRENT=2
# Max keywords to monitor (1-50, default: 20)
MAX_KEYWORDS=20

# --- Security ---
# Secret key for cookie encryption (auto-generated if empty)
SECRET_KEY=
