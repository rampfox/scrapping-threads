# Handle line endings secara otomatis
* text=auto

# Python files - LF
*.py text eol=lf

# Web files - LF
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Config files - LF
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.env.example text eol=lf
Dockerfile text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
